#!/bin/sh
# Maven Wrapper Script
set -e

MAVEN_HOME="${HOME}/.m2/wrapper/dists/apache-maven-3.9.9"
MAVEN_DOWNLOAD_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.9/apache-maven-3.9.9-bin.zip"

if [ ! -d "$MAVEN_HOME" ]; then
  mkdir -p "$MAVEN_HOME"
  echo "Downloading Maven 3.9.9..."
  wget -q -O /tmp/maven.zip "$MAVEN_DOWNLOAD_URL"
  unzip -q /tmp/maven.zip -d "$MAVEN_HOME"
  rm /tmp/maven.zip
fi

MAVEN_BIN=$(find "$MAVEN_HOME" -name "mvn" -type f | head -1)
exec "$MAVEN_BIN" "$@"